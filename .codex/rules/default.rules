# Codex command-execution policy for Financial Calculators.
#
# Git writes require an explicit user request under AGENTS.md; prompt rules
# allow that request to proceed through the runtime approval flow. Allow rules
# reduce friction for routine tooling, not authorize unrelated data, schema,
# infrastructure, or remote changes. Prefix rules are not complete enforcement:
# alternate invocation forms and the command's contents still require review.

# --- Forbidden -------------------------------------------------------------

prefix_rule(
	pattern = ["rm", "-rf", "/"],
	decision = "forbidden",
	justification = "Recursive deletion at filesystem root is destructive.",
)

prefix_rule(
	pattern = ["rm", "-rf", "/workspace"],
	decision = "forbidden",
	justification = "Recursive deletion of the repository root is destructive.",
)

# --- Prompt ----------------------------------------------------------------

prefix_rule(
	pattern = ["git", ["add", "branch", "switch", "checkout", "commit", "push", "merge", "rebase", "cherry-pick", "revert", "tag", "stash", "reset", "restore", "clean"]],
	decision = "prompt",
	justification = "Git writes require an explicit user request; confirm the requested operation.",
	match = ["git commit -m example", "git reset --hard HEAD", "git reset --soft HEAD"],
	not_match = ["git status", "git diff", "git --hard"],
)

prefix_rule(
	pattern = ["rm", "-rf"],
	decision = "prompt",
	justification = "Recursive deletion can be destructive.",
)











prefix_rule(
	pattern = ["docker"],
	decision = "prompt",
	justification = "Container lifecycle is owned by the developer on the host.",
)

# --- Allow: routine development tooling ------------------------------------









prefix_rule(
	pattern = ["npm", ["install", "ci", "run", "test"]],
	decision = "allow",
	justification = "UI dependency and routine dev/test commands.",
)

prefix_rule(
	pattern = ["npx"],
	decision = "allow",
	justification = "Project CLIs and the Svelte MCP helper.",
)

prefix_rule(
	pattern = ["node"],
	decision = "allow",
	justification = "Project script execution.",
)











# --- Allow: repository inspection and HTTP tooling -------------------------

prefix_rule(
	pattern = ["git", ["status", "diff", "log", "show", "ls-files", "blame"]],
	decision = "allow",
	justification = "Read-only git inspection.",
)

prefix_rule(
	pattern = ["curl"],
	decision = "allow",
	justification = "HTTP tooling within the authorized task; write methods and remote destinations still require authorization.",
)

prefix_rule(
	pattern = ["rg"],
	decision = "allow",
	justification = "Repository search.",
)

prefix_rule(
	pattern = ["ls"],
	decision = "allow",
	justification = "Filesystem listing.",
)

prefix_rule(
	pattern = ["cat"],
	decision = "allow",
	justification = "Read files.",
)

prefix_rule(
	pattern = ["sed"],
	decision = "allow",
	justification = "Text processing within the authorized task; in-place edits are writes.",
)

prefix_rule(
	pattern = ["find"],
	decision = "allow",
	justification = "Filesystem traversal within the authorized task; mutation flags are not read-only.",
)
