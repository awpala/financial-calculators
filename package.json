{
  "name": "financial-calculators",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{svelte,ts,js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,js,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "svelte-kit sync",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test && npm run build && npm run test:deployment",
    "test:deployment": "node --test scripts/deployment.test.mjs",
    "test:container": "bash scripts/test-container.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/kit": "^3.0.0-next.27",
    "@sveltejs/mcp": "^0.1.26",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.6",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@sveltejs/adapter-static": "4.0.0-next.4"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "sanitize-html": "^2.17.7",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "puppeteer": "^25.11.0",
    "shiki": "^4.4.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
