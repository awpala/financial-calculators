{
  "name": "financial-calculators",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{svelte,ts,js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,js,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "svelte-kit sync",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test && npm run build && npm run test:deployment",
    "test:deployment": "node --test scripts/deployment.test.mjs",
    "test:container": "bash scripts/test-container.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/mcp": "^0.1.30",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "d3": "^7.9.2",
    "puppeteer": "^25.17.0",
    "sanitize-html": "^2.18.2",
    "shiki": "^4.6.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
